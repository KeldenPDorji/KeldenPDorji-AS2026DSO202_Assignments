# Environment-style source for the configMapGenerator.
# Each line becomes one key in the generated ConfigMap, so the configuration
# lives in a plain file that a developer can read and diff, rather than inside
# a hand-written ConfigMap resource.
#
# Both naming conventions are present: the backend reads DB_*, the official
# PostgreSQL image reads POSTGRES_*. The names differ but the values must match.
DB_HOST=db-svc
DB_PORT=5432
DB_NAME=taskdb
APP_PORT=8080
CORS_ORIGIN=*
POSTGRES_DB=taskdb
BACKEND_URL=http://localhost:30080
